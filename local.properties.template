# Copy keys into local.properties (alongside sdk.dir generated by Android Studio),
# or configure them at runtime inside the phone app Settings screen.

# Open Charge Map (required for live EV charger queries):
# https://openchargemap.org/site/profile/applications
OPEN_CHARGE_MAP_API_KEY=

# Football-Data.org v4 (optional; free ESPN EPL scoreboard is enabled by default):
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
